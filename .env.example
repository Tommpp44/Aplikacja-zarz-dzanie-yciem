# --- Supabase (required) -----------------------------------------------------
# Local: values printed by `npx supabase start` / `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Used for account deletion, scheduled jobs and seeding.
# Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---------------------------------------------------------------------
# Public URL of the app (used for auth redirects / magic links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma separated OAuth providers enabled in Supabase Auth (e.g. "google,github").
# Leave empty to hide OAuth buttons.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Shared secret for /api/cron/* endpoints (Vercel Cron sends it as Bearer token).
CRON_SECRET=change-me

# --- Web Push (optional) -------------------------------------------------------
# Reminders on phones/desktops even when LifeOS is closed. Generate a key pair with
#   npx web-push generate-vapid-keys
# Leave empty to disable push (in-app notifications keep working).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- AI (optional, future) -----------------------------------------------------
# LifeOS works without AI. Set a provider to enable LLM-backed features later.
AI_PROVIDER=rules
